+int __svgalib_get_vtactive(int fd)
+{
+    int v;
+#if defined(VT_GETSTATE)
+    struct vt_stat vts;
+
+    if (ioctl(fd, VT_GETSTATE, &vts) == 0)
+        v = vts.v_active;
+    else
+        v = -1;
+#elif defined(VT_GETACTIVE)
+    if (ioctl(fd, VT_GETACTIVE, &v) != 0)
+        v = -1;
+#else
+#error "need porting to this platform"
+#endif
+    return v;
+}
